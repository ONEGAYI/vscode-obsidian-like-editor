{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vsidian: 启动扩展开发宿主",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "port": 46186,
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/extension.js"],
      "preLaunchTask": "Vsidian: 编译"
    }
  ]
}
