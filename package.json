{
  "name": "vsidian",
  "displayName": "Vsidian",
  "icon": "media/vsidian-icon.png",
  "description": "在 VSCode 中提供类 Obsidian 的 Markdown 编辑体验",
  "version": "0.1.0",
  "publisher": "onegayi",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "onegayi.vsidian.editor",
        "displayName": "Vsidian",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "onegayi.vsidian.toggleViewMode",
        "title": "切换实时预览与阅读模式",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.find",
        "title": "查找（编辑区）",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.create",
        "title": "%command.table.create.title%",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertRowAbove",
        "title": "表格：上方插入行",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertRowBelow",
        "title": "表格：下方插入行",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.deleteRow",
        "title": "表格：删除行",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertColumnLeft",
        "title": "表格：左侧插入列",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertColumnRight",
        "title": "表格：右侧插入列",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.deleteColumn",
        "title": "表格：删除列",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.openSettings",
        "title": "打开设置",
        "category": "Vsidian"
      }
    ],
    "keybindings": [
      {
        "command": "onegayi.vsidian.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == onegayi.vsidian.editor"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs && tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run && node --test test/integration/testHost.test.mjs",
    "test:integration": "node esbuild.mjs && node ./test/integration/runTest.mjs",
    "test:browser": "node test/browser/tableCaret.mjs",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ONEGAYI/vsidian.git"
  },
  "private": true,
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.86.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
