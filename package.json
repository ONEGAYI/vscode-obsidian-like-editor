{
  "name": "vscode-obsidian-like-editor",
  "displayName": "Obsidian-like Markdown Editor",
  "description": "在 VSCode 中提供类 Obsidian 的 Markdown 编辑体验",
  "version": "0.1.0",
  "publisher": "onegayi",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "onegayi.obsidian-like-markdown-editor",
        "displayName": "Obsidian-like Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs && tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "node esbuild.mjs && node ./test/integration/runTest.mjs",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ONEGAYI/vscode-obsidian-like-editor.git"
  },
  "private": true,
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.86.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
