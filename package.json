{
  "name": "vsidian",
  "displayName": "Vsidian",
  "icon": "media/vsidian-icon-256.png",
  "description": "类 Obsidian 的 Markdown 编辑体验：实时预览 + 阅读双视图 | Obsidian-like Markdown editing (live preview + reading)",
  "version": "0.1.0",
  "publisher": "onegayi",
  "license": "MIT",
  "keywords": [
    "markdown",
    "obsidian",
    "live preview",
    "wysiwyg",
    "note",
    "notes",
    "wikilink",
    "table"
  ],
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "onegayi.vsidian.editor",
        "displayName": "Vsidian",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "onegayi.vsidian.toggleViewMode",
        "title": "切换到下一视图模式",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.mode.toReading",
        "title": "切换到阅读模式",
        "category": "Vsidian",
        "icon": "$(book)"
      },
      {
        "command": "onegayi.vsidian.mode.toSource",
        "title": "切换到源码编辑器",
        "category": "Vsidian",
        "icon": "$(code)"
      },
      {
        "command": "onegayi.vsidian.mode.toLive",
        "title": "切换到实时预览",
        "category": "Vsidian",
        "icon": "$(edit)"
      },
      {
        "command": "onegayi.vsidian.find",
        "title": "查找（编辑区）",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.create",
        "title": "%command.table.create.title%",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertRowAbove",
        "title": "表格：上方插入行",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertRowBelow",
        "title": "表格：下方插入行",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.deleteRow",
        "title": "表格：删除行",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertColumnLeft",
        "title": "表格：左侧插入列",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.insertColumnRight",
        "title": "表格：右侧插入列",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.table.deleteColumn",
        "title": "表格：删除列",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.bold",
        "title": "粗体",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.italic",
        "title": "斜体",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.strikethrough",
        "title": "删除线",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.inlineCode",
        "title": "行内代码",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.heading1",
        "title": "一级标题",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.heading2",
        "title": "二级标题",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.heading3",
        "title": "三级标题",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.heading4",
        "title": "四级标题",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.heading5",
        "title": "五级标题",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.heading6",
        "title": "六级标题",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.headingNone",
        "title": "取消标题",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.bulletList",
        "title": "无序列表",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.orderedList",
        "title": "有序列表",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.taskList",
        "title": "任务列表",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.quote",
        "title": "引用",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.codeBlock",
        "title": "代码块",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.link",
        "title": "链接",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.format.clearInline",
        "title": "清除行内格式",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.insert.inlineMath",
        "title": "插入行内公式",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.insert.blockMath",
        "title": "插入块级公式",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.insert.wikilink",
        "title": "插入双链",
        "category": "Vsidian"
      },
      {
        "command": "onegayi.vsidian.openSettings",
        "title": "打开设置",
        "category": "Vsidian"
      }
    ],
    "keybindings": [
      {
        "command": "onegayi.vsidian.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == onegayi.vsidian.editor"
      },
      {
        "command": "onegayi.vsidian.format.bold",
        "key": "ctrl+b",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      },
      {
        "command": "onegayi.vsidian.format.headingNone",
        "key": "ctrl+0",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      },
      {
        "command": "onegayi.vsidian.format.heading1",
        "key": "ctrl+1",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      },
      {
        "command": "onegayi.vsidian.format.heading2",
        "key": "ctrl+2",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      },
      {
        "command": "onegayi.vsidian.format.heading3",
        "key": "ctrl+3",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      },
      {
        "command": "onegayi.vsidian.format.heading4",
        "key": "ctrl+4",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      },
      {
        "command": "onegayi.vsidian.format.heading5",
        "key": "ctrl+5",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      },
      {
        "command": "onegayi.vsidian.format.heading6",
        "key": "ctrl+6",
        "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "onegayi.vsidian.mode.toReading",
          "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == live && !isInDiffEditor",
          "group": "navigation"
        },
        {
          "command": "onegayi.vsidian.mode.toSource",
          "when": "activeCustomEditorId == onegayi.vsidian.editor && vsidian.activeMode == reading && !isInDiffEditor",
          "group": "navigation"
        },
        {
          "command": "onegayi.vsidian.mode.toLive",
          "when": "(resourceExtname == .md || resourceExtname == .markdown) && !activeCustomEditorId && !activeWebviewPanelId && !isInDiffEditor",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs && tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run && node --test test/integration/testHost.test.mjs test/release/release.test.mjs",
    "test:integration": "node esbuild.mjs && node ./test/integration/runTest.mjs",
    "test:browser": "node test/browser/tableCaret.mjs && node test/browser/outlineJump.mjs && node test/browser/outlineCollapse.mjs && node test/browser/outlineSearch.mjs && node test/browser/outlineMenu.mjs && node test/browser/outlineDrag.mjs && node test/browser/outlineDragBoundary.mjs && node test/browser/settingsPage.mjs",
    "release:check": "node scripts/release.mjs",
    "release": "node scripts/release.mjs --upload",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ONEGAYI/vsidian.git"
  },
  "bugs": {
    "url": "https://github.com/ONEGAYI/vsidian/issues"
  },
  "homepage": "https://github.com/ONEGAYI/vsidian#readme",
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "@vscode/markdown-it-katex": "1.1.2",
    "katex": "0.16.47",
    "markdown-it": "15.0.2",
    "mermaid": "11.12.2"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.86.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
